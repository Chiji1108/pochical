      "colored": true,
      "emoji": { "names": false, "off": "mark", "offs": {} },
      "fill": true,
      "icon": { "names": false, "off": "highlight", "offs": {} },
      "style": "icon"
    },
    "picture": { "names": true, "off": "highlight", "offs": {} },
    "theme": "pochical",
    "week": { "holiday": true, "saturday": true, "start": 0, "sunday": true }
  },
  "roundTrips": [
