{
  "about": "A month's shifts as events in the device's calendar (spec/calendar.md, Adding a month to the device calendar). `days` are the month's days as they show, a pattern id and any hours of the day's own; `patterns` give each pattern's name, its time (none is all day) and whether it counts as off. Each event is the pattern's name, `start` and `end` in minutes from the day's midnight, past 1440 when the shift ends the next day, or null for all day. Days off are left out but for the patterns `includeOff` names. A day of work without a time (its own or its pattern's) that the day before's event runs into, like 明け after 夜勤, is left out, as that event shows on it already; never the month's first day, whose day before is another month's that may never have been added; `carriedOver`, when given, names the patterns so left out, in the order of the days first left out on (none when not given). Optional `notes` (each day's memo) and `people` (each day's names, in order) are given only when the person asks for them; an event's `notes` is the memo, then 一緒に働く人：A、B on its own line, left out without either. A day with a memo and no shift's event (no shift, or a day off left out) gets an all-day event of its own, named by the memo's first line, the whole memo in its notes only when it runs longer.",
  "events": [
    {
      "name": "work at its pattern's time, days off left out",
      "month": "2026-11-01",
      "patterns": {
        "day": { "name": "日勤", "time": ["08:30", "17:30"], "off": false },
        "off": { "name": "休み", "off": true }
      },
      "days": {
        "2026-11-02": { "shift": "day" },
        "2026-11-03": { "shift": "off" }
      },
      "includeOff": [],
      "expected": [
        { "day": "2026-11-02", "title": "日勤", "start": 510, "end": 1050 }
      ]
    },
    {
      "name": "days off all day when asked for",
      "month": "2026-11-01",
      "patterns": {
        "day": { "name": "日勤", "time": ["08:30", "17:30"], "off": false },
        "off": { "name": "休み", "off": true }
      },
      "days": {
        "2026-11-02": { "shift": "day" },
        "2026-11-03": { "shift": "off" }
      },
      "includeOff": ["off"],
      "expected": [
        { "day": "2026-11-02", "title": "日勤", "start": 510, "end": 1050 },
        { "day": "2026-11-03", "title": "休み", "start": null, "end": null }
      ]
    },
    {
      "name": "a night shift ends the next day",
      "month": "2026-11-01",
      "patterns": {
        "night": { "name": "夜勤", "time": ["16:30", "09:00"], "off": false }
      },
      "days": {
        "2026-11-05": { "shift": "night" }
      },
      "includeOff": [],
      "expected": [
        { "day": "2026-11-05", "title": "夜勤", "start": 990, "end": 1980 }
      ]
    },
    {
      "name": "a day's own hours win over its pattern's",
      "month": "2026-11-01",
      "patterns": {
        "day": { "name": "日勤", "time": ["08:30", "17:30"], "off": false }
      },
      "days": {
        "2026-11-09": { "shift": "day", "start": "07:00", "end": "20:00" },
        "2026-11-10": { "shift": "day", "end": "19:00" }
      },
      "includeOff": [],
      "expected": [
        { "day": "2026-11-09", "title": "日勤", "start": 420, "end": 1200 },
        { "day": "2026-11-10", "title": "日勤", "start": 510, "end": 1140 }
      ]
    },
    {
      "name": "work without a time is all day, other months left out",
      "month": "2026-11-01",
      "patterns": {
        "duty": { "name": "当番", "off": false }
      },
      "days": {
        "2026-10-31": { "shift": "duty" },
        "2026-11-01": { "shift": "duty" },
        "2026-12-01": { "shift": "duty" }
      },
      "includeOff": [],
      "expected": [
        { "day": "2026-11-01", "title": "当番", "start": null, "end": null }
      ]
    },
    {
      "name": "the memo and who works the day go in the notes when asked for",
      "month": "2026-11-01",
      "patterns": {
        "day": { "name": "日勤", "time": ["08:30", "17:30"], "off": false }
      },
      "days": {
        "2026-11-02": { "shift": "day" },
        "2026-11-04": { "shift": "day" },
        "2026-11-05": { "shift": "day" }
      },
      "includeOff": [],
      "notes": { "2026-11-02": "歓迎会", "2026-11-05": "引き継ぎ" },
      "people": { "2026-11-02": ["田中", "佐藤"], "2026-11-04": ["田中"] },
      "expected": [
