{
  "about": "A month's shifts as events in the device's calendar (spec/calendar.md, Adding a month to the device calendar). `days` are the month's days as they show, a pattern id and any hours of the day's own; `patterns` give each pattern's name and its time (none is all day); `shown` are the patterns picked under 入れるシフト, the only ones put in. Each event is the pattern's name, `start` and `end` in minutes from the day's midnight, past 1440 when the shift ends the next day (at or before its start), or null for all day. Optional `notes` (each day's memo) and `people` (each day's names, in order) are given only when the person asks for them; an event's `notes` is the memo, then 一緒に働く人：A、B on its own line, left out without either. A day with a memo and no shift's event (no shift, or a pattern not picked) gets an all-day event of its own, named by the memo's first line, the whole memo in its notes only when it runs longer. `shownAtFirst` gives the patterns picked until the person picks otherwise: those with a time, and of those without, all but the days off (`off`) and a pattern another names as its next day (`nextDay`), like 明け after 夜勤, whose night shows on that day already.",
  "events": [
    {
      "name": "work at its pattern's time, a pattern not picked left out",
      "month": "2026-11-01",
      "patterns": {
        "day": { "name": "日勤", "time": ["08:30", "17:30"] },
        "off": { "name": "休み" }
      },
      "days": {
        "2026-11-02": { "shift": "day" },
        "2026-11-03": { "shift": "off" }
      },
      "shown": ["day"],
      "expected": [
        { "day": "2026-11-02", "title": "日勤", "start": 510, "end": 1050 }
      ]
    },
    {
      "name": "days off all day when picked",
      "month": "2026-11-01",
      "patterns": {
        "day": { "name": "日勤", "time": ["08:30", "17:30"] },
        "off": { "name": "休み" }
      },
      "days": {
        "2026-11-02": { "shift": "day" },
        "2026-11-03": { "shift": "off" }
      },
      "shown": ["day", "off"],
      "expected": [
        { "day": "2026-11-02", "title": "日勤", "start": 510, "end": 1050 },
        { "day": "2026-11-03", "title": "休み", "start": null, "end": null }
      ]
    },
    {
      "name": "a night shift ends the next day",
      "month": "2026-11-01",
      "patterns": {
        "night": { "name": "夜勤", "time": ["16:30", "09:00"] }
      },
      "days": {
        "2026-11-05": { "shift": "night" }
      },
      "shown": ["night"],
      "expected": [
        { "day": "2026-11-05", "title": "夜勤", "start": 990, "end": 1980 }
      ]
    },
    {
      "name": "a day's own hours win over its pattern's",
      "month": "2026-11-01",
      "patterns": {
        "day": { "name": "日勤", "time": ["08:30", "17:30"] }
      },
      "days": {
        "2026-11-09": { "shift": "day", "start": "07:00", "end": "20:00" },
        "2026-11-10": { "shift": "day", "end": "19:00" }
      },
      "shown": ["day"],
      "expected": [
        { "day": "2026-11-09", "title": "日勤", "start": 420, "end": 1200 },
        { "day": "2026-11-10", "title": "日勤", "start": 510, "end": 1140 }
      ]
    },
    {
      "name": "work without a time is all day, other months left out",
      "month": "2026-11-01",
      "patterns": {
        "duty": { "name": "当番" }
      },
      "days": {
        "2026-10-31": { "shift": "duty" },
        "2026-11-01": { "shift": "duty" },
        "2026-12-01": { "shift": "duty" }
      },
      "shown": ["duty"],
      "expected": [
        { "day": "2026-11-01", "title": "当番", "start": null, "end": null }
      ]
    },
    {
      "name": "the memo and who works the day go in the notes when asked for",
      "month": "2026-11-01",
      "patterns": {
        "day": { "name": "日勤", "time": ["08:30", "17:30"] }
      },
      "days": {
        "2026-11-02": { "shift": "day" },
        "2026-11-04": { "shift": "day" },
        "2026-11-05": { "shift": "day" }
      },
      "notes": { "2026-11-02": "歓迎会", "2026-11-05": "引き継ぎ" },
      "people": { "2026-11-02": ["田中", "佐藤"], "2026-11-04": ["田中"] },
      "shown": ["day"],
      "expected": [
        {
          "day": "2026-11-02",
          "title": "日勤",
          "start": 510,
          "end": 1050,
          "notes": "歓迎会\n一緒に働く人：田中、佐藤"
        },
        {
          "day": "2026-11-04",
          "title": "日勤",
          "start": 510,
          "end": 1050,
          "notes": "一緒に働く人：田中"
        },
        {
          "day": "2026-11-05",
          "title": "日勤",
          "start": 510,
          "end": 1050,
          "notes": "引き継ぎ"
        }
      ]
    },
    {
      "name": "a memo with no shift's event gets one of its own",
      "month": "2026-11-01",
      "patterns": {
        "day": { "name": "日勤", "time": ["08:30", "17:30"] },
        "off": { "name": "休み" }
      },
      "days": {
        "2026-11-02": { "shift": "day" },
        "2026-11-03": { "shift": "off" }
      },
      "notes": { "2026-11-03": "歓迎会", "2026-11-07": "旅行\n京都まで" },
      "people": { "2026-11-03": ["田中"] },
      "shown": ["day"],
      "expected": [
        { "day": "2026-11-02", "title": "日勤", "start": 510, "end": 1050 },
        { "day": "2026-11-03", "title": "歓迎会", "start": null, "end": null },
        {
          "day": "2026-11-07",
          "title": "旅行",
          "start": null,
          "end": null,
          "notes": "旅行\n京都まで"
        }
      ]
    },
    {
      "name": "a pattern left out keeps the day's memo as an event of its own",
      "month": "2026-11-01",
      "patterns": {
        "night": { "name": "夜勤", "time": ["16:30", "09:00"] },
        "after": { "name": "明け" }
      },
      "days": {
        "2026-11-05": { "shift": "night" },
        "2026-11-06": { "shift": "after" }
      },
      "notes": { "2026-11-06": "歯医者" },
      "people": { "2026-11-06": ["田中"] },
      "shown": ["night"],
      "expected": [
        { "day": "2026-11-05", "title": "夜勤", "start": 990, "end": 1980 },
        { "day": "2026-11-06", "title": "歯医者", "start": null, "end": null }
      ]
    },
    {
      "name": "only the patterns picked",
      "month": "2026-11-01",
      "patterns": {
        "off": { "name": "休み" },
        "paid": { "name": "有休" }
      },
      "days": {
        "2026-11-07": { "shift": "off" },
        "2026-11-10": { "shift": "paid" }
      },
      "shown": ["paid"],
      "expected": [
        { "day": "2026-11-10", "title": "有休", "start": null, "end": null }
      ]
    }
  ],
  "shownAtFirst": [
    {
      "name": "timed work in, days off and a night's next day out, other untimed work in",
      "patterns": {
        "day": { "time": ["09:00", "18:00"] },
        "night": { "time": ["16:30", "09:30"], "nextDay": "after" },
        "after": {},
        "off": { "off": true },
        "paid": { "off": true },
        "offDuty": {},
        "trip": {}
      },
      "expected": ["day", "night", "offDuty", "trip"]
    },
    {
      "name": "a pattern with a time stays in when named as a next day, and a day off with a time too",
      "patterns": {
        "night": { "time": ["16:30", "09:30"], "nextDay": "after" },
        "after": { "nextDay": "night" },
        "halfOff": { "time": ["13:00", "18:00"], "off": true }
      },
      "expected": ["halfOff", "night"]
    }
  ]
}
