{
  "about": "A month's shifts as events in the device's calendar (spec/calendar.md, Adding a month to the device calendar). The page is `month`'s, or with `start` (a シフトの期間's first day, spec/vectors/periods.json) the period starting in that month. `days` are the month's days as they show, a pattern id and any hours of the day's own; `patterns` give each pattern's name and its time (none is all day); `shown` are the patterns picked under 入れるシフト, the only ones put in. Each event is the pattern's name, `start` and `end` in minutes from the day's midnight, past 1440 when the shift ends the next day (at or before its start), or null for all day. Optional `notes` (each day's memo) and `people` (each day's names, in order) are given only when the person asks for them; an event's `notes` is the memo, then 一緒に働く人：A、B on its own line, left out without either. A day with a memo and no shift's event (no shift, or a pattern not picked) gets an all-day event of its own, named by the memo's first line, the whole memo in its notes only when it runs longer. `shownAtFirst` gives the patterns picked until the person picks otherwise: those with a time, and of those without, all but the days off (`off`) and a pattern another names as its next day (`nextDay`), like 明け after 夜勤, whose night shows on that day already. `picks` pin what is kept of the person's picks (`chosen`, a pattern id to put in or left out, only where it differs from the first pick): `pick`, when given, picks one pattern (`id`) in or out (`on`) first, which drops any choice of a pattern no longer there and keeps none for one picked back to its first pick; `expectedChosen` is what is kept then, and `expectedShown` the patterns put in. `marks` pin Pochical's mark on each event it puts in, a line of its own at the end of the event's notes, the app's link to the day and whose shift it is: `notes` is what the event says without it, `day` and `user` the mark's; `expected` is the notes it goes in with. `marksRead` pin finding it again in an event's notes, whatever else they say and however their lines end (a line feed alone ends one, a carriage return before it, spaces and tabs around the link aside): `expected` is the day and the user the mark names, or null for an event that is not Pochical's: no line that is the link alone, another link, or a day that is none. Of two such lines, the last is the event's own.",
  "events": [
    {
      "name": "work at its pattern's time, a pattern not picked left out",
      "month": "2026-11-01",
      "patterns": {
        "day": { "name": "日勤", "time": ["08:30", "17:30"] },
        "off": { "name": "休み" }
      },
      "days": {
        "2026-11-02": { "shift": "day" },
        "2026-11-03": { "shift": "off" }
      },
      "shown": ["day"],
      "expected": [
        { "day": "2026-11-02", "title": "日勤", "start": 510, "end": 1050 }
      ]
    },
    {
      "name": "days off all day when picked",
      "month": "2026-11-01",
      "patterns": {
        "day": { "name": "日勤", "time": ["08:30", "17:30"] },
        "off": { "name": "休み" }
      },
      "days": {
        "2026-11-02": { "shift": "day" },
        "2026-11-03": { "shift": "off" }
      },
      "shown": ["day", "off"],
      "expected": [
        { "day": "2026-11-02", "title": "日勤", "start": 510, "end": 1050 },
        { "day": "2026-11-03", "title": "休み", "start": null, "end": null }
      ]
    },
    {
      "name": "a night shift ends the next day",
      "month": "2026-11-01",
      "patterns": {
        "night": { "name": "夜勤", "time": ["16:30", "09:00"] }
      },
      "days": {
        "2026-11-05": { "shift": "night" }
      },
      "shown": ["night"],
      "expected": [
        { "day": "2026-11-05", "title": "夜勤", "start": 990, "end": 1980 }
      ]
    },
    {
      "name": "a day's own hours win over its pattern's",
      "month": "2026-11-01",
      "patterns": {
        "day": { "name": "日勤", "time": ["08:30", "17:30"] }
      },
      "days": {
        "2026-11-09": { "shift": "day", "start": "07:00", "end": "20:00" },
        "2026-11-10": { "shift": "day", "end": "19:00" }
      },
      "shown": ["day"],
      "expected": [
        { "day": "2026-11-09", "title": "日勤", "start": 420, "end": 1200 },
        { "day": "2026-11-10", "title": "日勤", "start": 510, "end": 1140 }
      ]
    },
    {
      "name": "work without a time is all day, other months left out",
      "month": "2026-11-01",
      "patterns": {
        "duty": { "name": "当番" }
      },
      "days": {
        "2026-10-31": { "shift": "duty" },
        "2026-11-01": { "shift": "duty" },
        "2026-12-01": { "shift": "duty" }
      },
      "shown": ["duty"],
      "expected": [
        { "day": "2026-11-01", "title": "当番", "start": null, "end": null }
      ]
    },
    {
      "name": "the memo and who works the day go in the notes when asked for",
      "month": "2026-11-01",
      "patterns": {
        "day": { "name": "日勤", "time": ["08:30", "17:30"] }
      },
      "days": {
        "2026-11-02": { "shift": "day" },
        "2026-11-04": { "shift": "day" },
        "2026-11-05": { "shift": "day" }
      },
      "notes": { "2026-11-02": "歓迎会", "2026-11-05": "引き継ぎ" },
      "people": { "2026-11-02": ["田中", "佐藤"], "2026-11-04": ["田中"] },
      "shown": ["day"],
      "expected": [
        {
          "day": "2026-11-02",
          "title": "日勤",
          "start": 510,
          "end": 1050,
          "notes": "歓迎会\n一緒に働く人：田中、佐藤"
        },
        {
          "day": "2026-11-04",
          "title": "日勤",
          "start": 510,
          "end": 1050,
          "notes": "一緒に働く人：田中"
        },
        {
          "day": "2026-11-05",
          "title": "日勤",
          "start": 510,
          "end": 1050,
          "notes": "引き継ぎ"
        }
      ]
    },
    {
      "name": "a memo with no shift's event gets one of its own",
      "month": "2026-11-01",
      "patterns": {
        "day": { "name": "日勤", "time": ["08:30", "17:30"] },
        "off": { "name": "休み" }
      },
      "days": {
        "2026-11-02": { "shift": "day" },
        "2026-11-03": { "shift": "off" }
      },
      "notes": { "2026-11-03": "歓迎会", "2026-11-07": "旅行\n京都まで" },
      "people": { "2026-11-03": ["田中"] },
      "shown": ["day"],
      "expected": [
        { "day": "2026-11-02", "title": "日勤", "start": 510, "end": 1050 },
        { "day": "2026-11-03", "title": "歓迎会", "start": null, "end": null },
        {
          "day": "2026-11-07",
          "title": "旅行",
          "start": null,
          "end": null,
          "notes": "旅行\n京都まで"
        }
      ]
    },
    {
      "name": "a pattern left out keeps the day's memo as an event of its own",
      "month": "2026-11-01",
      "patterns": {
        "night": { "name": "夜勤", "time": ["16:30", "09:00"] },
        "after": { "name": "明け" }
      },
      "days": {
        "2026-11-05": { "shift": "night" },
        "2026-11-06": { "shift": "after" }
      },
      "notes": { "2026-11-06": "歯医者" },
      "people": { "2026-11-06": ["田中"] },
      "shown": ["night"],
      "expected": [
        { "day": "2026-11-05", "title": "夜勤", "start": 990, "end": 1980 },
        { "day": "2026-11-06", "title": "歯医者", "start": null, "end": null }
      ]
    },
    {
      "name": "a period's page puts in its own days, across two months",
      "month": "2026-10-01",
      "start": 15,
      "patterns": {
        "day": { "name": "日勤", "time": ["08:30", "17:30"] }
      },
      "days": {
        "2026-10-14": { "shift": "day" },
        "2026-10-15": { "shift": "day" },
        "2026-11-14": { "shift": "day" },
        "2026-11-15": { "shift": "day" }
      },
      "shown": ["day"],
      "expected": [
        { "day": "2026-10-15", "title": "日勤", "start": 510, "end": 1050 },
        { "day": "2026-11-14", "title": "日勤", "start": 510, "end": 1050 }
      ]
    },
    {
      "name": "only the patterns picked",
      "month": "2026-11-01",
      "patterns": {
        "off": { "name": "休み" },
        "paid": { "name": "有休" }
      },
      "days": {
        "2026-11-07": { "shift": "off" },
        "2026-11-10": { "shift": "paid" }
      },
      "shown": ["paid"],
      "expected": [
        { "day": "2026-11-10", "title": "有休", "start": null, "end": null }
      ]
    }
  ],
  "shownAtFirst": [
    {
      "name": "timed work in, days off and a night's next day out, other untimed work in",
      "patterns": {
        "day": { "time": ["09:00", "18:00"] },
        "night": { "time": ["16:30", "09:30"], "nextDay": "after" },
        "after": {},
        "off": { "off": true },
        "paid": { "off": true },
        "offDuty": {},
        "trip": {}
      },
      "expected": ["day", "night", "offDuty", "trip"]
    },
    {
      "name": "a pattern with a time stays in when named as a next day, and a day off with a time too",
      "patterns": {
        "night": { "time": ["16:30", "09:30"], "nextDay": "after" },
        "after": { "nextDay": "night" },
        "halfOff": { "time": ["13:00", "18:00"], "off": true }
      },
      "expected": ["halfOff", "night"]
    }
  ],
  "picks": [
    {
      "name": "a choice puts in or leaves out against the first pick",
      "patterns": {
        "day": { "time": ["09:00", "18:00"] },
        "off": { "off": true }
      },
      "chosen": { "day": false, "off": true },
      "expectedChosen": { "day": false, "off": true },
      "expectedShown": ["off"]
    },
    {
      "name": "a pattern picked otherwise is kept",
      "patterns": {
        "night": { "time": ["16:30", "09:30"], "nextDay": "after" },
        "after": {}
      },
      "chosen": {},
      "pick": { "id": "after", "on": true },
      "expectedChosen": { "after": true },
      "expectedShown": ["after", "night"]
    },
    {
      "name": "a pattern picked back to its first pick keeps no choice",
      "patterns": {
        "day": { "time": ["09:00", "18:00"] },
        "off": { "off": true }
      },
      "chosen": { "off": true },
      "pick": { "id": "off", "on": false },
      "expectedChosen": {},
      "expectedShown": ["day"]
    },
    {
      "name": "a deleted pattern's choice goes with the next pick",
      "patterns": {
        "day": { "time": ["09:00", "18:00"] },
        "off": { "off": true }
      },
      "chosen": { "gone": true, "day": false },
      "pick": { "id": "off", "on": true },
      "expectedChosen": { "day": false, "off": true },
      "expectedShown": ["off"]
    }
  ],
  "marks": [
    {
      "name": "an event with no notes carries the mark alone",
      "day": "2026-11-02",
      "user": "u7Hk2Qx",
      "expected": "pochical://day/2026-11-02?by=u7Hk2Qx"
    },
    {
      "name": "the mark follows the memo and the people on its own line",
      "day": "2026-11-05",
      "user": "u7Hk2Qx",
      "notes": "申し送りあり\n一緒に働く人：佐藤、田中",
      "expected": "申し送りあり\n一緒に働く人：佐藤、田中\npochical://day/2026-11-05?by=u7Hk2Qx"
    }
  ],
  "marksRead": [
    {
      "name": "the mark alone",
      "notes": "pochical://day/2026-11-02?by=u7Hk2Qx",
      "expected": { "day": "2026-11-02", "user": "u7Hk2Qx" }
    },
    {
      "name": "after the memo",
      "notes": "申し送りあり\npochical://day/2026-11-05?by=u7Hk2Qx",
      "expected": { "day": "2026-11-05", "user": "u7Hk2Qx" }
    },
    {
      "name": "lines ended as another calendar ends them, spaces around",
      "notes": "申し送りあり\r\n  pochical://day/2026-11-05?by=u7Hk2Qx \r\n",
      "expected": { "day": "2026-11-05", "user": "u7Hk2Qx" }
    },
    {
      "name": "a mark copied into the memo gives way to the event's own, the last",
      "notes": "pochical://day/2026-12-01?by=u7Hk2Qx\npochical://day/2026-11-05?by=u7Hk2Qx",
      "expected": { "day": "2026-11-05", "user": "u7Hk2Qx" }
    },
    {
      "name": "only a line feed ends a line",
      "notes": "申し送りあり\u2028pochical://day/2026-11-05?by=u7Hk2Qx",
      "expected": null
    },
    {
      "name": "someone else's mark is read as theirs",
      "notes": "pochical://day/2026-11-02?by=family1",
      "expected": { "day": "2026-11-02", "user": "family1" }
    },
    {
      "name": "no notes",
      "notes": "",
      "expected": null
    },
    {
      "name": "the link inside a sentence of the person's",
      "notes": "pochical://day/2026-11-02?by=u7Hk2Qx を見る",
      "expected": null
    },
    {
      "name": "the site's link, not the app's",
      "notes": "https://pochical.app/day/2026-11-02?by=u7Hk2Qx",
      "expected": null
    },
    {
      "name": "a link to a day with no user",
      "notes": "pochical://day/2026-11-02",
      "expected": null
    },
    {
      "name": "a link with more than the user",
      "notes": "pochical://day/2026-11-02?by=u7Hk2Qx&x=1",
      "expected": null
    },
    {
      "name": "a date that is no day",
      "notes": "pochical://day/2026-02-30?by=u7Hk2Qx",
      "expected": null
    },
    {
      "name": "a group's link",
      "notes": "pochical://group/g1/day/2026-11-02",
      "expected": null
    }
  ]
}
