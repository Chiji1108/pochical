          "day": "2026-11-02",
          "title": "日勤",
          "start": 510,
          "end": 1050,
          "notes": "歓迎会\n一緒に働く人：田中、佐藤"
        },
        {
          "day": "2026-11-04",
          "title": "日勤",
          "start": 510,
          "end": 1050,
          "notes": "一緒に働く人：田中"
        },
        {
          "day": "2026-11-05",
          "title": "日勤",
          "start": 510,
          "end": 1050,
          "notes": "引き継ぎ"
        }
      ]
    },
    {
