      "expected": true
    },
    {
      "name": "the same week started on a Wednesday",
      "sequence": ["day", "day", "day", "off", "off", "day", "day"],
      "start": "2026-10-07",
      "daysOff": ["off"],
      "expected": true
    },
    {
      "name": "off on a weekday only",
      "sequence": ["day", "day", "off", "day", "day", "day", "day"],
      "start": "2026-10-05",
      "daysOff": ["off"],
      "expected": false
    },
    {
      "name": "any pattern that counts as off",
      "sequence": ["day", "day", "day", "day", "day", "day", "paid"],
      "start": "2026-10-05",
      "daysOff": ["off", "paid"],
      "expected": true
    },
    {
      "name": "only an order of seven reads as a week",
      "sequence": ["day", "day", "day", "day", "off", "off"],
      "start": "2026-10-05",
      "daysOff": ["off"],
      "expected": false
    }
  ],
