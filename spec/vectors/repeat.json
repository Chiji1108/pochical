{
  "about": "A repeating order of shifts (spec/shift-patterns.md, Repeating orders). schedule: each day from `from` to `to` takes the order's shift counted in whole days from `anchor`, which falls on the order's first shift; days before the anchor count backwards. With `holidayShift`, the national holidays of `holidays` (a country code, design/scripts/holidays.ts) take that pattern instead. shown: the days as they show from a person's orders and own days. A day follows the latest order that starts on or before it; an order with an empty sequence ends repeating; a pattern not in `patterns` leaves its days empty, whether the order or the day's own shift names it. A day's own `shift` wins over its order, and \"\" (dayRules.noShift, design/src/days.ts) is a day cleared on purpose; an own day without one follows its order. holidaysOffByDefault: 祝日は休みにする starts on when the order is a week (seven shifts) with a pattern that counts as off on a Saturday or Sunday; `daysOff` are the patterns that count as off. holidayShift: what holidays become, the first pattern that counts as off, in the person's order. added: an order added to `orders` (a new rotation, a new job, or one dated back) starts on its day; orders that started on or after it give way to it entirely, and those before stay.",
  "schedule": [
    {
      "name": "a three-day order from its anchor",
      "sequence": ["day", "night", "after"],
      "anchor": "2026-10-01",
      "from": "2026-10-01",
      "to": "2026-10-07",
      "expected": {
        "2026-10-01": "day",
        "2026-10-02": "night",
        "2026-10-03": "after",
        "2026-10-04": "day",
        "2026-10-05": "night",
        "2026-10-06": "after",
        "2026-10-07": "day"
      }
    },
    {
      "name": "days before the anchor line up too",
      "sequence": ["day", "night", "after", "off"],
      "anchor": "2026-10-10",
      "from": "2026-10-05",
      "to": "2026-10-12",
      "expected": {
        "2026-10-05": "off",
        "2026-10-06": "day",
        "2026-10-07": "night",
        "2026-10-08": "after",
        "2026-10-09": "off",
        "2026-10-10": "day",
        "2026-10-11": "night",
        "2026-10-12": "after"
      }
    },
    {
      "name": "an order of one",
      "sequence": ["day"],
      "anchor": "2026-10-01",
      "from": "2026-10-01",
      "to": "2026-10-03",
      "expected": {
        "2026-10-01": "day",
        "2026-10-02": "day",
        "2026-10-03": "day"
      }
    },
    {
      "name": "across the end of a year",
      "sequence": ["day", "off"],
      "anchor": "2026-12-30",
      "from": "2026-12-30",
      "to": "2027-01-02",
      "expected": {
        "2026-12-30": "day",
        "2026-12-31": "off",
        "2027-01-01": "day",
        "2027-01-02": "off"
      }
    },
    {
      "name": "a leap day is a day like any other",
      "sequence": ["day", "night", "after"],
      "anchor": "2028-02-27",
      "from": "2028-02-27",
      "to": "2028-03-02",
      "expected": {
        "2028-02-27": "day",
        "2028-02-28": "night",
        "2028-02-29": "after",
        "2028-03-01": "day",
        "2028-03-02": "night"
      }
    },
    {
      "name": "far from its anchor, still counted in whole days",
      "sequence": ["day", "night", "after"],
      "anchor": "2000-01-01",
      "from": "2026-10-01",
      "to": "2026-10-03",
      "expected": {
        "2026-10-01": "after",
        "2026-10-02": "day",
        "2026-10-03": "night"
      }
    },
    {
      "name": "holidays keep the order when nothing is put on them",
      "sequence": ["day", "day", "day", "day", "day", "off", "off"],
      "anchor": "2026-04-27",
      "from": "2026-04-27",
      "to": "2026-05-07",
      "expected": {
        "2026-04-27": "day",
        "2026-04-28": "day",
        "2026-04-29": "day",
        "2026-04-30": "day",
        "2026-05-01": "day",
        "2026-05-02": "off",
        "2026-05-03": "off",
        "2026-05-04": "day",
        "2026-05-05": "day",
        "2026-05-06": "day",
        "2026-05-07": "day"
      }
    },
    {
      "name": "holidays take the day-off pattern, substitute holidays too",
      "sequence": ["day", "day", "day", "day", "day", "off", "off"],
      "anchor": "2026-04-27",
      "from": "2026-04-27",
      "to": "2026-05-07",
      "holidays": "JP",
      "holidayShift": "off",
      "expected": {
        "2026-04-27": "day",
        "2026-04-28": "day",
        "2026-04-29": "off",
        "2026-04-30": "day",
        "2026-05-01": "day",
        "2026-05-02": "off",
        "2026-05-03": "off",
        "2026-05-04": "off",
        "2026-05-05": "off",
        "2026-05-06": "off",
        "2026-05-07": "day"
      }
    }
  ],
  "shown": [
    {
      "name": "a later order takes over on its start",
      "orders": [
        {
          "sequence": ["day", "night"],
          "start": "2026-10-01"
        },
        {
          "sequence": ["off"],
          "start": "2026-10-04"
        }
      ],
      "patterns": ["day", "night", "off"],
      "own": {},
      "from": "2026-10-01",
      "to": "2026-10-06",
      "expected": {
        "2026-10-01": "day",
        "2026-10-02": "night",
        "2026-10-03": "day",
        "2026-10-04": "off",
        "2026-10-05": "off",
        "2026-10-06": "off"
      }
    },
    {
      "name": "an empty sequence ends repeating",
      "orders": [
        {
          "sequence": ["day"],
          "start": "2026-10-01"
        },
        {
          "sequence": [],
          "start": "2026-10-03"
        }
      ],
      "patterns": ["day"],
      "own": {},
      "from": "2026-10-01",
      "to": "2026-10-05",
      "expected": {
        "2026-10-01": "day",
        "2026-10-02": "day"
      }
    },
    {
      "name": "nothing before the first order starts, though it counts from an earlier anchor",
      "orders": [
        {
          "sequence": ["day", "night"],
          "start": "2026-10-03",
          "anchor": "2026-10-01"
        }
      ],
      "patterns": ["day", "night"],
      "own": {},
      "from": "2026-10-01",
      "to": "2026-10-05",
      "expected": {
        "2026-10-03": "day",
        "2026-10-04": "night",
        "2026-10-05": "day"
      }
    },
    {
      "name": "a day's own shift wins, and \"\" clears a day on purpose",
      "orders": [
        {
          "sequence": ["day"],
          "start": "2026-10-01"
        }
      ],
      "patterns": ["day", "night"],
      "own": {
        "2026-10-02": {
          "shift": "night"
        },
        "2026-10-03": {
          "shift": ""
        },
        "2026-10-04": {},
        "2026-10-07": {
          "shift": "night"
        }
      },
      "from": "2026-10-01",
      "to": "2026-10-07",
      "expected": {
        "2026-10-01": "day",
        "2026-10-02": "night",
        "2026-10-04": "day",
        "2026-10-05": "day",
        "2026-10-06": "day",
        "2026-10-07": "night"
      }
    },
    {
      "name": "a pattern that is gone leaves its days empty",
      "orders": [
        {
          "sequence": ["day", "gone"],
          "start": "2026-10-01"
        }
      ],
      "patterns": ["day"],
      "own": {},
      "from": "2026-10-01",
      "to": "2026-10-04",
      "expected": {
        "2026-10-01": "day",
        "2026-10-03": "day"
      }
    },
    {
      "name": "the holidays of an order with holidaysOff take its holidayShift",
      "orders": [
        {
          "sequence": ["day"],
          "start": "2026-11-01",
          "holidaysOff": true,
          "holidayShift": "off"
        }
      ],
      "patterns": ["day", "off"],
      "own": {},
      "from": "2026-11-02",
      "to": "2026-11-04",
      "expected": {
        "2026-11-02": "day",
        "2026-11-03": "off",
        "2026-11-04": "day"
      }
    },
    {
      "name": "a day's own shift naming a pattern that is gone shows nothing",
      "orders": [
        {
          "sequence": ["day"],
          "start": "2026-10-01"
        }
      ],
      "patterns": ["day"],
      "own": {
        "2026-10-02": {
          "shift": "gone",
          "note": "棚卸し"
        }
      },
      "from": "2026-10-01",
      "to": "2026-10-03",
      "expected": {
        "2026-10-01": "day",
        "2026-10-03": "day"
      }
    }
  ],
  "holidaysOffByDefault": [
    {
      "name": "a week off on Saturday and Sunday",
      "sequence": ["day", "day", "day", "day", "day", "off", "off"],
      "start": "2026-10-05",
