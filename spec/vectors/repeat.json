      ],
      "order": {
        "sequence": ["night"],
        "start": "2026-10-01"
      },
      "expected": [
        {
          "sequence": ["day"],
          "start": "2026-01-01"
        },
        {
          "sequence": ["night"],
          "start": "2026-10-01"
        }
      ]
    },
    {
      "name": "a new order starting earlier replaces the orders after it",
      "orders": [
        {
          "sequence": ["day"],
          "start": "2026-01-01"
        },
        {
          "sequence": ["night"],
          "start": "2026-10-01"
        }
      ],
      "order": {
