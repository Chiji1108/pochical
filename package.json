{
  "name": "pochical",
  "private": true,
  "license": "PolyForm-Strict-1.0.0",
  "type": "module",
  "scripts": {
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tools && tsc --noEmit -p tools/layout-diff",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "lefthook install",
    "web": "pnpm --dir apps/web dev",
    "build:web": "pnpm --dir apps/web build",
    "preview:web": "pnpm --dir apps/web preview",
    "design": "pnpm --dir apps/design dev",
    "try": "pnpm --dir apps/try dev",
    "server": "pnpm --dir apps/server dev",
    "admin": "pnpm --dir apps/admin dev"
  },
  "devDependencies": {
    "@astrojs/compiler-rs": "^0.5.2",
    "@bufbuild/protobuf": "2.16.0",
    "@pochical/design": "workspace:*",
    "@types/node": "catalog:",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "playwright-core": "catalog:",
    "sharp": "0.35.5",
    "tsx": "catalog:",
    "typescript": "~7.0.2",
    "ultracite": "8.0.1",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@12.15.0"
}
