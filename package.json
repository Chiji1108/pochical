{
  "name": "pochical",
  "private": true,
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/mobile-legacy",
    "apps/server",
    "apps/web"
  ],
  "scripts": {
    "typecheck": "bun run --cwd apps/web typecheck && bun run --cwd apps/server typecheck",
    "test": "bun run --cwd apps/web test && bun run --cwd apps/server test",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "lefthook install",
    "web": "bun run --cwd apps/web dev",
    "build:web": "bun run --cwd apps/web build",
    "preview:web": "bun run --cwd apps/web preview",
    "server": "bun run --cwd apps/server dev"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "lefthook": "^2.1.6",
    "ultracite": "7.6.2"
  },
  "trustedDependencies": [
    "@shopify/react-native-skia",
    "protobufjs",
    "uniwind"
  ],
  "patchedDependencies": {
    "react-native-view-shot@6.0.1": "patches/react-native-view-shot@6.0.1.patch",
    "@convex-dev/auth@0.0.95": "patches/@convex-dev%2Fauth@0.0.95.patch",
    "react-native@0.88.0-rc.1": "patches/react-native@0.88.0-rc.1.patch",
    "@trestleinc/replicate@2.0.0-preview.0": "patches/@trestleinc%2Freplicate@2.0.0-preview.0.patch",
    "convex-unread-tracking@1.1.0": "patches/convex-unread-tracking@1.1.0.patch",
    "@kesha-antonov/react-native-chat@5.0.1": "patches/@kesha-antonov%2Freact-native-chat@5.0.1.patch"
  }
}
