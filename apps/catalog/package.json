  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.26.0",
    "@pandacss/dev": "^1.12.1",
    "@types/bun": "^1.4.2",
    "@types/node": "25.6.0",
    "@types/react": "~19.3.0",
