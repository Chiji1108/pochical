{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The design catalog at catalog.pochical.app: /design's documents, and
  // the prototype to try at /try and /demo, behind Cloudflare Access (its
  // Access tab) and kept out of search (src/routes/__root.tsx).
  "name": "pochical-catalog",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Branches other than main are uploaded as Worker Previews by Workers
  // Builds (`wrangler preview`), which needs this block, even empty.
  "previews": {},
  "routes": [{ "pattern": "catalog.pochical.app", "custom_domain": true }],
  // Kept beside the custom domain, behind the same Access, for each pull
  // request's preview: with routes set, Wrangler turns workers.dev off
  // unless told.
  "workers_dev": true,
  "preview_urls": true,
}
