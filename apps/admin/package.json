{
  "name": "@pochical/admin",
  "private": true,
  "license": "PolyForm-Strict-1.0.0",
  "type": "module",
  "scripts": {
    "dev": "react-router dev --port 3100 --strictPort",
    "build": "react-router build",
    "deploy": "bun run build && wrangler deploy",
    "cf-typegen": "rm -f worker-configuration.d.ts && wrangler types --strict-vars=false -c wrangler.jsonc -c ../server/wrangler.jsonc",
    "typegen": "react-router typegen",
    "prepare": "bun run typegen",
    "typecheck": "bun run typegen && tsc --noEmit"
  },
  "dependencies": {
    "@pochical/design": "workspace:*",
    "@pochical/jsx": "workspace:*",
    "@pochical/prototype": "workspace:*",
    "@pochical/styled-system": "workspace:*",
    "isbot": "^5.1.40",
    "lucide-react": "^1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.26.0",
    "@pandacss/dev": "^2.3.0",
    "@react-router/dev": "8.5.0",
    "@types/react": "~19.3.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "~7.0.2",
    "vite": "^8.0.0",
    "wrangler": "^4.151.3"
  }
}
