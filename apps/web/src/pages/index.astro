---
import siteIcon from "@pochical/prototype/assets/icon.png?url";
import widgetWall from "@pochical/prototype/assets/widget-wall.png";
import { site } from "@pochical/prototype/lib/brand";
import { defaultDayBeforeTime } from "@pochical/prototype/lib/design-reminders";
import { SITE_WALL } from "@pochical/prototype/lib/store-shots";
import { css } from "@pochical/styled-system/css";
import { Picture } from "astro:assets";
import {
  BellRing,
  CalendarOff,
  ImageDown,
  MegaphoneOff,
  Shapes,
  UserRound,
} from "lucide-react";
import type { LucideIcon } from "lucide-react";

import {
  FeatureScreen,
  HeroPhone,
  Sky,
  ThemeGallery,
} from "../components/lp-screens";
import ShotHeadline from "../components/shot-headline.astro";
import StoreLinks from "../components/store-links.astro";
import Site from "../layouts/site.astro";
import { primaryAction } from "../lib/primary-action";
import { appStoreUrl, googlePlayUrl } from "../lib/site";

// Which phones the app is still on its way to, said under the store links
// (components/store-links.astro) until each store's URL is set.
const waiting = [
  { phone: "iPhone", url: appStoreUrl() },
  { phone: "Android", url: googlePlayUrl() },
]
  .filter((store) => !store.url)
  .map((store) => store.phone);
const release =
  waiting.length > 0 && `${waiting.join("・")} 向けに、ただいま準備中。`;

// The page's words are its own HTML; what the app's own code draws, its
// skies and its phones, are islands (components/lp-screens.tsx), drawn by
// the build and taken over once their code is in: the hero's when the
// browser is idle, the rest as a scroll brings them about a screen away.
const NEAR = { rootMargin: "100% 0px" };

// The site's muted gray, a step darker: over the sky it keeps above 5:1,
// where the site's own falls short of 4.5:1.
const ON_SKY_TEXT = "#5c6159";

const hero = {
  copy: css({
    _wide: {
      gridColumn: 1,
      gridRow: 1,
      paddingTop: "120px",
      textAlign: "left",
    },
    display: "flex",
    flexDirection: "column",
    gap: "24px",
    maxWidth: "460px",
    textAlign: "center",
  }),
  demo: css({
    _wide: { display: "contents" },
    display: "flex",
    flexDirection: "column",
    gap: "18px",
    width: "min(390px, 100%)",
  }),
  description: css({
    color: ON_SKY_TEXT,
    fontSize: "15px",
    letterSpacing: "0.035em",
    lineHeight: 2.1,
  }),
  eyebrow: css({
    color: "var(--green)",
    fontSize: "11px",
    fontWeight: 650,
    letterSpacing: "0.17em",
  }),
  release: css({ color: ON_SKY_TEXT, fontSize: "11px" }),
  // Wide, the words on the left and the phone on the right, and what is
  // under the phone on a narrow screen (HeroPhone's foot) under the words
  // instead, where it is seen beside the phone without scrolling.
  root: css({
    _wide: {
      alignItems: "start",
      columnGap: "96px",
      display: "grid",
      gridTemplateColumns: "minmax(0, 460px) 390px",
      gridTemplateRows: "auto 1fr",
      justifyContent: "center",
      padding: "24px 48px 96px",
      rowGap: "40px",
    },
    alignItems: "center",
    display: "flex",
    flexDirection: "column",
    gap: "48px",
    padding: "40px 16px 72px",
  }),
  store: css({
    "& .store-links": { _wide: { justifyContent: "flex-start" } },
    display: "flex",
    flexDirection: "column",
    gap: "12px",
  }),
  title: css({
    fontSize: "clamp(38px, 5.2vw, 60px)",
    fontWeight: 700,
    letterSpacing: "0.01em",
    lineHeight: 1.4,
  }),
};

// ポチッと。 is a button, though it keeps the heading's look: pressed, it
// sinks a little and springs back, and drifts the sky behind it. Nothing
// hints at it; it is there for whoever tries. The press itself is CSS, so
// it answers even before the sky's code arrives.
const pressed = css({
  "&:active": {
    transform: "translateY(3px) scale(0.92)",
    transition: "transform 0.12s ease-in",
  },
  "@media (prefers-reduced-motion: reduce)": { transition: "none" },
  WebkitTapHighlightColor: "transparent",
  bg: "transparent",
  border: 0,
  color: "inherit",
  display: "inline-block",
  font: "inherit",
  letterSpacing: "inherit",
  padding: 0,
  touchAction: "manipulation",
  transformOrigin: "50% 100%",
  transition: "transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1)",
  userSelect: "none",
});

// The wall's width on the page: half its picture's, drawn for dense
// screens.
const WALL_SHOWN = SITE_WALL.width / 2;

const feature = {
  body: css({
    color: "var(--muted)",
    fontSize: "14px",
    letterSpacing: "0.035em",
    lineHeight: 2.1,
  }),
  // A feature's words: beside its screen, from the left when wide.
  copy: css({
    _wide: { textAlign: "left" },
    display: "flex",
    flexDirection: "column",
    gap: "18px",
    maxWidth: "400px",
    textAlign: "center",
  }),
  label: css({
    color: "var(--green)",
    fontSize: "11px",
    fontWeight: 650,
    letterSpacing: "0.17em",
  }),
  list: css({
    _wide: { gap: "140px", padding: "80px 48px 140px" },
    display: "flex",
    flexDirection: "column",
    gap: "96px",
    listStyle: "none",
    margin: "0 auto",
    maxWidth: "1080px",
    padding: "40px 16px 96px",
  }),
  // Each row its copy, then its screen, as they stack on a phone. Wide,
  // the screens take turns from the left: the hero's phone is on the
  // right, so the first feature's comes in on the other side.
  row: css({
    _wide: {
      "&:nth-child(odd)": { flexDirection: "row-reverse" },
      flexDirection: "row",
      gap: "120px",
      justifyContent: "center",
    },
    alignItems: "center",
    display: "flex",
    flexDirection: "column",
    gap: "36px",
  }),
  title: css({
    fontSize: "clamp(26px, 3vw, 34px)",
    fontWeight: 700,
    letterSpacing: "0.01em",
    lineHeight: 1.5,
  }),
  // The real widgets on a wall (SITE_WALL, drawn by mise run store:images),
  // at a phone's width beside the others, fading into the paper at every
  // edge: the picture above and below, and its frame at the sides, a mask
  // each, so no browser has two to put together.
  wall: css({
    display: "block",
    height: "auto",
    maskImage:
      "linear-gradient(to bottom, transparent, black 14%, black 86%, transparent)",
    width: "100%",
  }),
  wallFrame: css({
    flexShrink: 0,
    maskImage:
      "linear-gradient(to right, transparent, black 10%, black 90%, transparent)",
    width: "min(390px, 100%)",
  }),
};

// Smaller things the app does, after the features' rows: a line each, no
// screen.
const extras: { Icon: LucideIcon; title: string; body: string }[] = [
  {
    Icon: BellRing,
    body: `前の日の${defaultDayBeforeTime}に、明日のシフトが届きます。`,
    title: "前の晩にお知らせ",
  },
  {
    Icon: Shapes,
    body: "日勤、夜勤、明け、早番、遅番など、名前・時間・印を自由に作れます。",
    title: "シフトは自由に作れる",
  },
  {
    Icon: ImageDown,
    body: "ひと月を1枚の画像に。そのまま家族に送れます。",
    title: "月まるごと画像で保存",
  },
  {
    Icon: CalendarOff,
    body: "忘年会のような集まりのグループは、決めた日にみんな一緒に終わります。",
    title: "グループに、終了日をつけられる",
  },
  {
    Icon: UserRound,
    body: "機種変更のときは、AppleまたはGoogleのアカウントで引き継げます。",
    title: "アカウント登録なしで始められる",
  },
  {
    Icon: MegaphoneOff,
    body: "ソースコードは公開しています。",
    title: "広告はありません",
  },
];

const more = {
  body: css({ color: "var(--muted)", fontSize: "13px", lineHeight: 1.9 }),
  icon: css({
    alignItems: "center",
    bg: "var(--soft-green)",
    borderRadius: "full",
    color: "var(--green)",
    display: "flex",
    flexShrink: 0,
    height: "40px",
    justifyContent: "center",
    width: "40px",
  }),
  item: css({ alignItems: "flex-start", display: "flex", gap: "16px" }),
  itemTitle: css({
    fontSize: "15px",
    fontWeight: 700,
    letterSpacing: "0.02em",
    lineHeight: 1.6,
  }),
  list: css({
    _wide: { gap: "40px 56px", gridTemplateColumns: "repeat(2, 1fr)" },
    display: "grid",
    gap: "28px",
    listStyle: "none",
    margin: 0,
    padding: 0,
  }),
  root: css({
    _wide: { padding: "0 48px 40px" },
    display: "flex",
    flexDirection: "column",
    gap: "40px",
    margin: "0 auto",
    maxWidth: "880px",
    padding: "0 16px 24px",
  }),
  title: css({
    fontSize: "clamp(22px, 2.4vw, 26px)",
    fontWeight: 700,
    letterSpacing: "0.01em",
    textAlign: "center",
  }),
};

// The page's end: the store links again for those who read this far, on
// the plain paper. Its ポチッと。 presses like the hero's, and as in the
// app, where おたのしみ has no sky until the first tap, its first press
// brings one up behind it.
const closing = {
  content: css({
    alignItems: "center",
    display: "flex",
    flexDirection: "column",
    gap: "24px",
  }),
  icon: css({ borderRadius: "14px" }),
  release: css({ color: ON_SKY_TEXT, fontSize: "11px" }),
  root: css({
    _wide: { padding: "120px 48px 160px" },
    display: "flex",
    isolation: "isolate",
    justifyContent: "center",
    padding: "96px 16px 120px",
    position: "relative",
    textAlign: "center",
  }),
  title: css({
    fontSize: "clamp(26px, 3vw, 34px)",
    fontWeight: 700,
    letterSpacing: "0.01em",
    lineHeight: 1.5,
  }),
};
---

<Site description={site.description} path="/" title="シフトを、ポチッと。">
  <main id="main">
    <section class={hero.root}>
      <div class={hero.copy}>
        <Sky client:idle place="top" />
        <p class={hero.eyebrow}>シフトカレンダー</p>
        <h1 class={hero.title}>
          シフトを、
          <br />
          <button class={pressed} data-press="top" type="button">
            ポチッと。
          </button>
        </h1>
        <p class={hero.description}>
          夜勤や交代勤務のシフトも、
          <br />
          ポチポチ押していくだけ。
          <br />
          ひと月ぶんが、すぐ入ります。
        </p>
        <div class={hero.store}>
          <StoreLinks />
          {release && <p class={hero.release}>{release}</p>}
        </div>
      </div>
      <div class={hero.demo}>
        <HeroPhone action={primaryAction(appStoreUrl())} client:idle />
      </div>
    </section>
    {/* What the app does, in the stores' order (store/README.md), each
       headline its store screenshot's (@pochical/prototype's
       lib/store-shots.ts). Beside each, its own screen, not touchable, so
       the page never drifts from the app; the widgets are the real ones,
       photographed for the stores. The seventh's three points stand
       beside 繰り返し's screen; the eighth's are said in the first row
       and in ほかにも. */}
    <ol aria-label="ポチカルでできること" class={feature.list}>
      <li class={feature.row}>
        <div class={feature.copy}>
          <p class={feature.label}>ENTRY</p>
          <ShotHeadline class={feature.title} shot="entry" />
          <p class={feature.body}>
            シフトのボタンを押すと、その日に入って次の日へ。
            <br />
            夜勤を入れると、次の日の明けも一緒に入ります。
          </p>
        </div>
        <FeatureScreen client:visible={NEAR} feature="entry" />
      </li>
      <li class={feature.row}>
        <div class={feature.copy}>
          <p class={feature.label}>WIDGET</p>
          <ShotHeadline class={feature.title} shot="widgets" />
          <p class={feature.body}>
            次の休みも、今日のシフトも、アプリを開かずに。
            <br />
            ひと月のカレンダーも、ホーム画面に置けます。
          </p>
        </div>
        <div class={feature.wallFrame}>
          <Picture
            alt="ポチカルのウィジェット。次の休みまでの日数、今日のシフト、いまのシフトの残り時間が並ぶ。"
            class={feature.wall}
            formats={["avif", "webp"]}
            sizes={`min(${WALL_SHOWN}px, 100vw - 32px)`}
            src={widgetWall}
            widths={[WALL_SHOWN, SITE_WALL.width]}
          />
        </div>
      </li>
      <li class={feature.row}>
        <div class={feature.copy}>
          <p class={feature.label}>SHARE</p>
          <ShotHeadline class={feature.title} shot="group-shifts" />
          <p class={feature.body}>
            みんなのシフトが、ひとつの表に並びます。
            <br />
            みんなが休みの日も、すぐ見つかります。
          </p>
        </div>
        <FeatureScreen client:visible={NEAR} feature="share" />
      </li>
      <li class={feature.row}>
        <div class={feature.copy}>
          <p class={feature.label}>CHAT</p>
          <ShotHeadline class={feature.title} shot="chat" />
          <p class={feature.body}>
            連絡先を交換していない人にも、グループのチャットで。
            <br />
            休みが合う日も、行ける日を押すだけで決まります。
          </p>
        </div>
        <FeatureScreen client:visible={NEAR} feature="chat" />
      </li>
      <li class={feature.row}>
        <div class={feature.copy}>
          <p class={feature.label}>STYLE</p>
          <ShotHeadline class={feature.title} shot="themes" />
          <p class={feature.body}>
            テーマは12種類。色を抑えた落ち着いたテーマも。
            <br />
            印は、アイコン・絵文字・文字から選べます。
          </p>
        </div>
        <ThemeGallery client:visible={NEAR} />
      </li>
      <li class={feature.row}>
        <div class={feature.copy}>
          <p class={feature.label}>YOUR CALENDAR</p>
          <ShotHeadline class={feature.title} shot="device-calendar" />
          <p class={feature.body}>
            シフトを、端末のカレンダーに入れられます。
            <br />
            Googleカレンダーの人も、ふだんの予定と並べて。
            <br />
            自動で反映にすると、変えたシフトが予定にも入ります。
          </p>
        </div>
        <FeatureScreen client:visible={NEAR} feature="deviceCalendar" />
      </li>
      <li class={feature.row}>
        <div class={feature.copy}>
          <p class={feature.label}>DETAILS</p>
          <ShotHeadline class={feature.title} shot="details" />
          <p class={feature.body}>
            決まった並びのシフトは、繰り返しで先の月まで。
            <br />
            15日始まりなど、月の途中から始まる勤務表にも。
            <br />
            早出や残業は、その日だけ変えられて、印でわかります。
          </p>
        </div>
        <FeatureScreen client:visible={NEAR} feature="repeat" />
      </li>
    </ol>
    <section aria-labelledby="more-title" class={more.root}>
      <h2 class={more.title} id="more-title">
        ほかにも
      </h2>
      <ul class={more.list}>
        {extras.map(({ Icon, title, body }) => (
          <li class={more.item}>
            <span class={more.icon}>
              <Icon aria-hidden="true" size={20} />
            </span>
            <div>
              <h3 class={more.itemTitle}>{title}</h3>
              <p class={more.body}>{body}</p>
            </div>
          </li>
        ))}
      </ul>
    </section>
    <section aria-labelledby="closing-title" class={closing.root}>
      <Sky bare client:visible place="sides" />
      <div class={closing.content}>
        <img
          alt=""
          class={closing.icon}
          height="64"
          src={siteIcon}
          width="64"
        />
        <h2 class={closing.title} id="closing-title">
          今月のシフトから、
          <br />
          <button class={pressed} data-press="sides" type="button">
            ポチッと。
          </button>
        </h2>
        <StoreLinks />
        {release && <p class={closing.release}>{release}</p>}
      </div>
    </section>
  </main>
</Site>

<script>
  import { press } from "../lib/presses";

  for (const button of document.querySelectorAll<HTMLButtonElement>(
    "button[data-press]"
  )) {
    const place = button.dataset.press;
    if (place === "top" || place === "sides") {
      button.addEventListener("click", () => {
        press(place);
      });
    }
  }
</script>
