---
import siteIcon from "@pochical/prototype/assets/icon.png?url";
import { site } from "@pochical/prototype/lib/brand";
import { defaultDayBeforeTime } from "@pochical/prototype/lib/design-reminders";
import { css } from "@pochical/styled-system/css";
import {
  BellRing,
  CalendarPlus,
  CalendarRange,
  Clock,
  ImageDown,
  UserRound,
} from "lucide-react";
import type { LucideIcon } from "lucide-react";

import {
  FeatureScreen,
  HeroPhone,
  Sky,
  ThemeGallery,
  WidgetScreen,
} from "../components/lp-screens";
import StoreLinks from "../components/store-links.astro";
import Site from "../layouts/site.astro";
import { primaryAction } from "../lib/primary-action";
import { appStoreUrl } from "../lib/site";

// The page's words are its own HTML; what the app's own code draws, its
// skies and its phones, are islands (components/lp-screens.tsx), drawn by
// the build and taken over once their code is in: the hero's when the
// browser is idle, the rest as a scroll brings them about a screen away.
const NEAR = { rootMargin: "100% 0px" };

// The site's muted gray, a step darker: over the sky it keeps above 5:1,
// where the site's own falls short of 4.5:1.
const ON_SKY_TEXT = "#5c6159";

const hero = {
  copy: css({
    _wide: {
      gridColumn: 1,
      gridRow: 1,
      paddingTop: "120px",
      textAlign: "left",
    },
    display: "flex",
    flexDirection: "column",
    gap: "24px",
    maxWidth: "460px",
    textAlign: "center",
  }),
  demo: css({
    _wide: { display: "contents" },
    display: "flex",
    flexDirection: "column",
    gap: "18px",
    width: "min(390px, 100%)",
  }),
  description: css({
    color: ON_SKY_TEXT,
    fontSize: "15px",
    letterSpacing: "0.035em",
    lineHeight: 2.1,
  }),
  eyebrow: css({
    color: "var(--green)",
    fontSize: "11px",
    fontWeight: 650,
    letterSpacing: "0.17em",
  }),
  release: css({ color: ON_SKY_TEXT, fontSize: "11px" }),
  // Wide, the words on the left and the phone on the right, and what is
  // under the phone on a narrow screen (HeroPhone's foot) under the words
  // instead, where it is seen beside the phone without scrolling.
  root: css({
    _wide: {
      alignItems: "start",
      columnGap: "96px",
      display: "grid",
      gridTemplateColumns: "minmax(0, 460px) 390px",
      gridTemplateRows: "auto 1fr",
      justifyContent: "center",
      padding: "24px 48px 96px",
      rowGap: "40px",
    },
    alignItems: "center",
    display: "flex",
    flexDirection: "column",
    gap: "48px",
    padding: "40px 16px 72px",
  }),
  store: css({
    "& .store-links": { _wide: { justifyContent: "flex-start" } },
    display: "flex",
    flexDirection: "column",
    gap: "12px",
  }),
  title: css({
    fontSize: "clamp(38px, 5.2vw, 60px)",
    fontWeight: 700,
    letterSpacing: "0.01em",
    lineHeight: 1.4,
  }),
};

// ポチッと。 is a button, though it keeps the heading's look: pressed, it
// sinks a little and springs back, and drifts the sky behind it. Nothing
// hints at it; it is there for whoever tries. The press itself is CSS, so
// it answers even before the sky's code arrives.
const pressed = css({
  "&:active": {
    transform: "translateY(3px) scale(0.92)",
    transition: "transform 0.12s ease-in",
  },
  "@media (prefers-reduced-motion: reduce)": { transition: "none" },
  WebkitTapHighlightColor: "transparent",
  bg: "transparent",
  border: 0,
  color: "inherit",
  display: "inline-block",
  font: "inherit",
  letterSpacing: "inherit",
  padding: 0,
  touchAction: "manipulation",
  transformOrigin: "50% 100%",
  transition: "transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1)",
  userSelect: "none",
});

const feature = {
  body: css({
    color: "var(--muted)",
    fontSize: "14px",
    letterSpacing: "0.035em",
    lineHeight: 2.1,
  }),
  copy: css({
    _wide: { textAlign: "left" },
    display: "flex",
    flexDirection: "column",
    gap: "18px",
    maxWidth: "400px",
    textAlign: "center",
  }),
  label: css({
    color: "var(--green)",
    fontSize: "11px",
    fontWeight: 650,
    letterSpacing: "0.17em",
  }),
  list: css({
    _wide: { gap: "140px", padding: "80px 48px 140px" },
    display: "flex",
    flexDirection: "column",
    gap: "96px",
    listStyle: "none",
    margin: "0 auto",
    maxWidth: "1080px",
    padding: "40px 16px 96px",
  }),
  // Each row its copy, then its screen, as they stack on a phone. Wide,
  // the screens take turns from the left: the hero's phone is on the
  // right, so the first feature's comes in on the other side.
  row: css({
    _wide: {
      "&:nth-child(odd)": { flexDirection: "row-reverse" },
      flexDirection: "row",
      gap: "120px",
      justifyContent: "center",
    },
    alignItems: "center",
    display: "flex",
    flexDirection: "column",
    gap: "36px",
  }),
  title: css({
    fontSize: "clamp(26px, 3vw, 34px)",
    fontWeight: 700,
    letterSpacing: "0.01em",
    lineHeight: 1.5,
  }),
};

// Smaller things the app does, after the features' rows: a line each, no
// screen.
const extras: { Icon: LucideIcon; title: string; body: string }[] = [
  {
    Icon: UserRound,
    body: "あとでログインすれば、機種変更してもそのまま。",
    title: "アカウント登録なしで始められる",
  },
  {
    Icon: BellRing,
    body: `前の日の${defaultDayBeforeTime}に、明日のシフトが届きます。`,
    title: "前の晩にお知らせ",
  },
  {
    Icon: CalendarPlus,
    body: "ひと月ぶんのシフトを、いつものカレンダーにまとめて追加。",
    title: "iPhoneやGoogleのカレンダーにも",
  },
  {
    Icon: ImageDown,
    body: "ひと月を1枚の画像に。写真に保存しても、そのまま送っても。",
    title: "月まるごと画像で保存",
  },
  {
    Icon: CalendarRange,
    body: "シフトが15日から翌月14日の分で出るなら、カレンダーの1ページをその期間に。お休みの数も、画像やカレンダーへの保存も、その期間で。",
    title: "15日始まりのシフトにも",
  },
  {
    Icon: Clock,
    body: "いつもと時間が違う日だけ、時間を変えられます。カレンダーにも、早出や残業の印がつきます。",
    title: "早出や残業も、その日だけ",
  },
];

const more = {
  body: css({ color: "var(--muted)", fontSize: "13px", lineHeight: 1.9 }),
  icon: css({
    alignItems: "center",
    bg: "var(--soft-green)",
    borderRadius: "full",
    color: "var(--green)",
    display: "flex",
    flexShrink: 0,
    height: "40px",
    justifyContent: "center",
    width: "40px",
  }),
  item: css({ alignItems: "flex-start", display: "flex", gap: "16px" }),
  itemTitle: css({
    fontSize: "15px",
    fontWeight: 700,
    letterSpacing: "0.02em",
    lineHeight: 1.6,
  }),
  list: css({
    _wide: { gap: "40px 56px", gridTemplateColumns: "repeat(2, 1fr)" },
    display: "grid",
    gap: "28px",
    listStyle: "none",
    margin: 0,
    padding: 0,
  }),
  root: css({
    _wide: { padding: "0 48px 40px" },
    display: "flex",
    flexDirection: "column",
    gap: "40px",
    margin: "0 auto",
    maxWidth: "880px",
    padding: "0 16px 24px",
  }),
  title: css({
    fontSize: "clamp(22px, 2.4vw, 26px)",
    fontWeight: 700,
    letterSpacing: "0.01em",
    textAlign: "center",
  }),
};

// The page's end: the store links again for those who read this far, on
// the plain paper. Its ポチッと。 presses like the hero's, and as in the
// app, where おたのしみ has no sky until the first tap, its first press
// brings one up behind it.
const closing = {
  content: css({
    alignItems: "center",
    display: "flex",
    flexDirection: "column",
    gap: "24px",
  }),
  icon: css({ borderRadius: "14px" }),
  release: css({ color: ON_SKY_TEXT, fontSize: "11px" }),
  root: css({
    _wide: { padding: "120px 48px 160px" },
    display: "flex",
    isolation: "isolate",
    justifyContent: "center",
    padding: "96px 16px 120px",
    position: "relative",
    textAlign: "center",
  }),
  title: css({
    fontSize: "clamp(26px, 3vw, 34px)",
    fontWeight: 700,
    letterSpacing: "0.01em",
    lineHeight: 1.5,
  }),
};
---

<Site description={site.description} path="/" title="シフトを、ポチッと。">
  <main id="main">
    <section class={hero.root}>
      <div class={hero.copy}>
        <Sky client:idle place="top" />
        <p class={hero.eyebrow}>シフトカレンダー</p>
        <h1 class={hero.title}>
          シフトを、
          <br />
          <button class={pressed} data-press="top" type="button">
            ポチッと。
          </button>
        </h1>
        <p class={hero.description}>
          ポチポチ押していくだけで、
          <br />
          ひと月ぶんが、すぐ埋まります。
          <br />
          家族や友だちとも、そのまま共有。
        </p>
        <div class={hero.store}>
          <StoreLinks />
          <p class={hero.release}>iPhone・Android 向けに、ただいま準備中。</p>
        </div>
      </div>
      <div class={hero.demo}>
        <HeroPhone action={primaryAction(appStoreUrl())} client:idle />
      </div>
    </section>
    {/* What else the app does, each beside its own screen: the real one,
       not touchable, so the page never drifts from the app. */}
    <ol aria-label="ポチカルでできること" class={feature.list}>
      <li class={feature.row}>
        <div class={feature.copy}>
          <p class={feature.label}>REPEAT</p>
          <h2 class={feature.title}>
            決まった順番なら、
            <br />
            毎月入れなくていい。
          </h2>
          <p class={feature.body}>
            当番・非番・休みも、工場の交代勤務も、
            <br />
            一度決めれば、毎月そのまま。
            <br />
            違う日だけ、ポチッと変えられます。
          </p>
        </div>
        <FeatureScreen client:visible={NEAR} feature="repeat" />
      </li>
      <li class={feature.row}>
        <div class={feature.copy}>
          <p class={feature.label}>WIDGET</p>
          <h2 class={feature.title}>
            アプリを開かなくても、
            <br />
            ホーム画面に。
          </h2>
          <p class={feature.body}>
            今日のシフトも、次の休みも。
            <br />
            みんなが休みの日まで、あと何日かも。
          </p>
        </div>
        <WidgetScreen client:visible={NEAR} />
      </li>
      <li class={feature.row}>
        <div class={feature.copy}>
          <p class={feature.label}>SHARE</p>
          <h2 class={feature.title}>
            「いつ休み？」が、
            <br />
            ひと目で。
          </h2>
          <p class={feature.body}>
            家族や友だちのシフトを、ひとつの表に。
            <br />
            みんなが休みの日も、すぐ見つかります。
          </p>
        </div>
        <FeatureScreen client:visible={NEAR} feature="share" />
      </li>
      <li class={feature.row}>
        <div class={feature.copy}>
          <p class={feature.label}>CHAT</p>
          <h2 class={feature.title}>
            「どの日にする？」も、
            <br />
            みんなで決めて。
          </h2>
          <p class={feature.body}>
            休みの合う日を候補にして、行ける日を押すだけ。
            <br />
            決まった日は、チャットのいちばん上に。
          </p>
        </div>
        <FeatureScreen client:visible={NEAR} feature="chat" />
      </li>
      <li class={feature.row}>
        <div class={feature.copy}>
          <p class={feature.label}>STYLE</p>
          <h2 class={feature.title}>
            見た目も、
            <br />
            自分らしく。
          </h2>
          <p class={feature.body}>
            テーマは12種類。
            <br />
            シフトの印も、好きな見た目に。
          </p>
        </div>
        <ThemeGallery client:visible={NEAR} />
      </li>
    </ol>
    <section aria-labelledby="more-title" class={more.root}>
      <h2 class={more.title} id="more-title">
        ほかにも
      </h2>
      <ul class={more.list}>
        {extras.map(({ Icon, title, body }) => (
          <li class={more.item}>
            <span class={more.icon}>
              <Icon aria-hidden="true" size={20} />
            </span>
            <div>
              <h3 class={more.itemTitle}>{title}</h3>
              <p class={more.body}>{body}</p>
            </div>
          </li>
        ))}
      </ul>
    </section>
    <section aria-labelledby="closing-title" class={closing.root}>
      <Sky bare client:visible place="sides" />
      <div class={closing.content}>
        <img
          alt=""
          class={closing.icon}
          height="64"
          src={siteIcon}
          width="64"
        />
        <h2 class={closing.title} id="closing-title">
          今月のシフトから、
          <br />
          <button class={pressed} data-press="sides" type="button">
            ポチッと。
          </button>
        </h2>
        <StoreLinks />
        <p class={closing.release}>iPhone・Android 向けに、ただいま準備中。</p>
      </div>
    </section>
  </main>
</Site>

<script>
  import { press } from "../lib/presses";

  for (const button of document.querySelectorAll<HTMLButtonElement>(
    "button[data-press]"
  )) {
    const place = button.dataset.press;
    if (place === "top" || place === "sides") {
      button.addEventListener("click", () => {
        press(place);
      });
    }
  }
</script>
