---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

// A guide's screenshot with its caption, made at build time as AVIF and
// WebP in the widths it is shown at (.guide-shots: at most 260 CSS
// pixels, twice that on a dense screen, and the screenshot's own 600 for
// a denser one), the PNG for browsers with neither.
type Props = { src: ImageMetadata; alt: string; caption: string };

const { alt, caption, src } = Astro.props;
---

<figure>
  <Picture
    alt={alt}
    formats={["avif", "webp"]}
    sizes="260px"
    src={src}
    widths={[260, 520, src.width]}
  />
  <figcaption>{caption}</figcaption>
</figure>
