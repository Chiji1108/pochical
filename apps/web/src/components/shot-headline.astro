---
import { STORE_SHOTS } from "@pochical/prototype/lib/store-shots";
import type { StoreShotName } from "@pochical/prototype/lib/store-shots";

// A part of the top page under the headline of the stores' picture of it
// (@pochical/prototype's lib/store-shots.ts), a line a line as the picture
// sets it, so the page says what the stores say.
type Props = { class: string; shot: StoreShotName };

const { class: className, shot } = Astro.props;
const lines = STORE_SHOTS.find((one) => one.name === shot)?.headline ?? [];
---

<h2 class={className}>
  {lines.map((line, index) => (
    <>
      {index > 0 && <br />}
      {line}
    </>
  ))}
</h2>
