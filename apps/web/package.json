{
  "name": "@pochical/web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview --port 3000",
    "deploy": "bun run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "typecheck": "tsr generate && tsc --noEmit && tsc --noEmit -p tsconfig.tools.json",
    "test": "bun test",
    "check": "bun run --cwd ../.. check",
    "fix": "bun run --cwd ../.. fix"
  },
  "dependencies": {
    "@auth/core": "0.41.1",
    "@convex-dev/auth": "0.0.95",
    "@holiday-jp/holiday_jp": "^2.5.2",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-router": "1.170.39",
    "@tanstack/react-start": "1.168.58",
    "convex": "^1.46.0",
    "lucide-react": "^0.577.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.26.0",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "25.6.0",
    "@types/react": "~19.3.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.0",
    "wrangler": "^4.137.0"
  }
}
