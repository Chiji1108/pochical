{
  "name": "@pochical/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --port 3000",
    "build": "astro build",
    "preview": "astro preview --port 3000",
    "deploy": "bun run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "sync": "astro sync",
    "prepare": "bun run sync",
    "typecheck": "astro check && tsc --noEmit -p tsconfig.tools.json",
    "test": "bun test",
    "check": "bun run --cwd ../.. check",
    "fix": "bun run --cwd ../.. fix"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.1",
    "@astrojs/react": "7.1.0",
    "@bufbuild/protobuf": "2.15.0",
    "@connectrpc/connect": "2.2.0",
    "@connectrpc/connect-web": "2.2.0",
    "@pochical/design": "workspace:*",
    "@pochical/jsx": "workspace:*",
    "@pochical/prototype": "workspace:*",
    "@pochical/styled-system": "workspace:*",
    "@resvg/resvg-wasm": "^2.6.2",
    "astro": "7.4.1",
    "lucide-react": "^0.577.0",
    "motion": "^13.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "satori": "0.32.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@pandacss/dev": "^2.3.0",
    "@types/node": "25.6.0",
    "@types/react": "~19.3.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "npm:@typescript/typescript6@~6.0.2",
    "vite": "^8.0.0",
    "wrangler": "^4.137.0"
  }
}
