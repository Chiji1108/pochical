{
  "name": "@pochical/web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "panda codegen && vite dev --port 3000",
    "generate-routes": "tsr generate",
    "icon:site": "bun scripts/site-icon.ts",
    "icon:app": "bun scripts/app-assets.ts",
    "build": "panda codegen && vite build",
    "preview": "vite preview --port 3000",
    "deploy": "bun run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "typecheck": "panda codegen && tsr generate && tsc --noEmit && tsc --noEmit -p tsconfig.tools.json",
    "test": "bun test",
    "check": "bun run --cwd ../.. check",
    "fix": "bun run --cwd ../.. fix",
    "prepare": "panda codegen"
  },
  "dependencies": {
    "@ark-ui/react": "^5.39.2",
    "@auth/core": "0.41.1",
    "@convex-dev/auth": "0.0.95",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@holiday-jp/holiday_jp": "^2.5.2",
    "@material/material-color-utilities": "^0.4.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-router": "1.170.39",
    "@tanstack/react-start": "1.168.58",
    "@tanstack/react-virtual": "^3.14.13",
    "convex": "^1.46.0",
    "frimousse": "^0.4.0",
    "lucide-react": "^0.577.0",
    "motion": "^13.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.26.0",
    "@pandacss/dev": "^1.12.1",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "25.6.0",
    "@types/react": "~19.3.0",
    "@types/react-dom": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "react-test-renderer": "19.3.0",
    "sharp": "0.35.4",
    "typescript": "~6.0.3",
    "vite": "^8.0.0",
    "wrangler": "^4.137.0"
  }
}
