{
  "name": "@pochical/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --cwd ../../packages/styled-system codegen && vite dev --port 3000",
    "icon:site": "bun scripts/site-icon.ts",
    "icon:app": "bun scripts/app-assets.ts",
    "icon:ios": "bun scripts/ios-app-icons.ts",
    "image:share": "bun scripts/share-image.ts",
    "build": "bun run --cwd ../../packages/styled-system codegen && vite build",
    "bundle:budget": "bun scripts/bundle-budget.ts",
    "preview": "vite preview --port 3000",
    "deploy": "bun run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "typecheck": "bun run --cwd ../../packages/styled-system codegen && tsc --noEmit && tsc --noEmit -p tsconfig.tools.json",
    "test": "bun test",
    "check": "bun run --cwd ../.. check",
    "fix": "bun run --cwd ../.. fix"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.15.0",
    "@connectrpc/connect": "2.2.0",
    "@connectrpc/connect-web": "2.2.0",
    "@pochical/design": "workspace:*",
    "@pochical/jsx": "workspace:*",
    "@pochical/prototype": "workspace:*",
    "@pochical/styled-system": "workspace:*",
    "@resvg/resvg-wasm": "^2.6.2",
    "@tanstack/react-router": "1.170.39",
    "@tanstack/react-start": "1.168.58",
    "lucide-react": "^0.577.0",
    "motion": "^13.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "satori": "0.32.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.26.0",
    "@pandacss/dev": "^1.12.1",
    "@phosphor-icons/react": "^2.1.10",
    "@types/node": "25.6.0",
    "@types/react": "~19.3.0",
    "@types/react-dom": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "react-test-renderer": "19.3.0",
    "sharp": "0.35.4",
    "typescript": "~6.0.3",
    "vite": "^8.0.0",
    "wrangler": "^4.137.0"
  }
}
