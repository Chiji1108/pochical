<?xml version="1.0" encoding="utf-8"?>
<!-- Today's frame in the calendar widget, round a tile's edge (WidgetParts' WidgetShape.frame),
     white for the widget to tint. Its inside is clear on purpose: a shape with no color inside
     fills it when tinted. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
  <corners android:radius="8dp" />
  <solid android:color="#00FFFFFF" />
  <stroke
    android:width="1.5dp"
    android:color="#FFFFFFFF" />
</shape>
