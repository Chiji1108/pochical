<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">

  <!-- Reads a group's QR code (ScanScreen); the camera app takes photos for faces. -->
  <uses-permission android:name="android.permission.CAMERA" />
  <uses-feature android:name="android.hardware.camera" android:required="false" />

  <!-- The browsers that open Custom Tabs, which AppleSignIn asks of Auth Tab. -->
  <queries>
    <intent>
      <action android:name="android.support.customtabs.action.CustomTabsService" />
    </intent>
  </queries>

  <application
    android:name=".PochicalApplication"
    android:icon="@mipmap/ic_launcher"
    android:label="@string/app_name"
    android:roundIcon="@mipmap/ic_launcher"
    android:supportsRtl="true"
    android:theme="@style/Theme.Pochical">
    <!-- Made by the app's Metro graph through MetroX's AppComponentFactory,
         which lint does not know of. Compose follows a change of light or
         dark itself, 外観's own among them, without the activity made anew.
         One of it in its task: Sign in with Apple's page, in a Custom Tab
         where the browser has no Auth Tab, returns by the app's scheme
         (AppleSignIn), which comes back to the activity that opened it,
         closing the tab above it. -->
    <activity
      android:name=".MainActivity"
      android:configChanges="uiMode"
      android:exported="true"
      android:launchMode="singleTask"
      android:theme="@style/Theme.Pochical.Starting"
      tools:ignore="Instantiatable">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
      <!-- AppleWebSignIn.RETURN_SCHEME and RETURN_HOST. -->
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="pochical" android:host="apple-sign-in" />
      </intent-filter>
      <!-- An invitation (OpenedLinks): the site's アプリで開く, as iOS's. -->
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="pochical" android:host="invite" />
      </intent-filter>
      <!-- A day, or a group's table, a widget opens (OpenedLinks; spec/widgets.md, Opening the
           app), as iOS's. -->
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="pochical" />
        <data android:host="day" />
        <data android:host="group" />
      </intent-filter>
      <!-- An invitation's own link, an App Link once Android has verified the site's
           /.well-known/assetlinks.json names this app (apps/web). -->
      <intent-filter android:autoVerify="true">
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="https" />
        <data android:host="pochical.app" />
        <data android:pathPrefix="/invite/" />
      </intent-filter>
    </activity>
    <!-- The camera app writes a photo taken for a face or a mark here (PhotoEditor). -->
    <provider
      android:name="androidx.core.content.FileProvider"
      android:authorities="${applicationId}.photos"
      android:exported="false"
      android:grantUriPermissions="true">
      <meta-data
        android:name="android.support.FILE_PROVIDER_PATHS"
        android:resource="@xml/photo_paths" />
    </provider>
    <!-- The home screen widgets (widgets/, spec/widgets.md), drawn by Glance. -->
    <receiver
      android:name=".widgets.SimpleWidgetReceiver"
      android:exported="true"
      android:label="@string/widget_simple">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/widget_simple" />
    </receiver>
    <receiver
      android:name=".widgets.NextOffWidgetReceiver"
      android:exported="true"
      android:label="@string/widget_next_off">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/widget_next_off" />
    </receiver>
    <receiver
      android:name=".widgets.UpcomingWidgetReceiver"
      android:exported="true"
      android:label="@string/widget_upcoming">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/widget_upcoming" />
    </receiver>
    <receiver
      android:name=".widgets.CalendarWidgetReceiver"
      android:exported="true"
      android:label="@string/widget_calendar">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/widget_calendar" />
    </receiver>
    <!-- The clock set or the time zone changed: the widgets' day and midnight move (WidgetUpdates). -->
    <receiver
      android:name=".widgets.WidgetClockReceiver"
      android:exported="false">
      <intent-filter>
        <action android:name="android.intent.action.TIME_SET" />
        <action android:name="android.intent.action.TIMEZONE_CHANGED" />
      </intent-filter>
    </receiver>
  </application>

</manifest>
