<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">

  <!-- Reads a group's QR code (ScanScreen); the camera app takes photos for faces. -->
  <uses-permission android:name="android.permission.CAMERA" />
  <uses-feature android:name="android.hardware.camera" android:required="false" />
  <!-- The chats' notifications, asked for from 設定 › 通知 (notifications/PermissionCard). -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- 端末カレンダーに追加: listing the device's calendars, finding the events Pochical put in, and
       putting them in or taking them out (spec/calendar.md), asked for as the page opens. -->
  <uses-permission android:name="android.permission.READ_CALENDAR" />
  <uses-permission android:name="android.permission.WRITE_CALENDAR" />
  <!-- The reminders go off at their minute (reminders/ReminderAlarms): the special access the
       person grants, asked for from 設定 › 通知 › リマインド. USE_EXACT_ALARM is left to alarm
       clocks and calendars whose core is their events' notifications, as Play's policy has it. -->
  <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
  <!-- The reminders' alarm set again as the device starts, which takes the system's alarms away. -->
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

  <!-- The browsers that open Custom Tabs, which AppleSignIn asks of Auth Tab. -->
  <queries>
    <intent>
      <action android:name="android.support.customtabs.action.CustomTabsService" />
    </intent>
  </queries>

  <application
    android:name=".PochicalApplication"
    android:icon="@mipmap/ic_launcher"
    android:label="@string/app_name"
    android:roundIcon="@mipmap/ic_launcher"
    android:supportsRtl="true"
    android:theme="@style/Theme.Pochical">
    <!-- Made by the app's Metro graph through MetroX's AppComponentFactory,
         which lint does not know of. Compose follows a change of light or
         dark itself, 外観's own among them, without the activity made anew.
         One of it in its task: Sign in with Apple's page, in a Custom Tab
         where the browser has no Auth Tab, returns by the app's scheme
         (AppleSignIn), which comes back to the activity that opened it,
         closing the tab above it. The screens make room for the keyboard
         themselves, from its insets (imePadding), as Compose asks: the window
         is never panned over them, which would lift a composer already risen
         a second time. -->
    <activity
      android:name=".MainActivity"
      android:configChanges="uiMode"
      android:exported="true"
      android:launchMode="singleTask"
      android:theme="@style/Theme.Pochical.Starting"
      android:windowSoftInputMode="adjustResize"
      tools:ignore="Instantiatable">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>      <!-- AppleWebSignIn.RETURN_SCHEME and RETURN_HOST. -->
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="pochical" android:host="apple-sign-in" />
      </intent-filter>
      <!-- An invitation (OpenedLinks): the site's アプリで開く, as iOS's. -->
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="pochical" android:host="invite" />
      </intent-filter>
      <!-- A day, or a group's table, a widget opens (OpenedLinks; spec/widgets.md, Opening the
           app), as iOS's. -->
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="pochical" />
        <data android:host="day" />
        <data android:host="group" />
      </intent-filter>
      <!-- The site's links the app opens, App Links once Android has verified the site's
           /.well-known/assetlinks.json names this app (apps/web): an invitation's own, and a
           day's, as a device calendar's event carries it (OpenedLinks; spec/calendar.md). -->
      <intent-filter android:autoVerify="true">
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="https" />
        <data android:host="pochical.app" />
        <data android:pathPrefix="/invite/" />
        <data android:pathPrefix="/day/" />
      </intent-filter>
    </activity>
    <!-- The server's notifications and the device's token, from FCM (notifications/Push). -->
    <service
      android:name=".notifications.PushService"
      android:exported="false">
      <intent-filter>
        <action android:name="com.google.firebase.MESSAGING_EVENT" />
      </intent-filter>
    </service>
    <!-- A chat's notification dismissed, which the app forgets (ChatNotifier). -->
    <receiver
      android:name=".notifications.NotificationDismissed"
      android:exported="false" />
    <!-- 返信 written on a chat's notification, sent without opening the app (ChatReply). -->
    <receiver
      android:name=".notifications.ChatReply"
      android:exported="false" />
    <!-- The reminders' alarm, and what takes the system's alarms away or moves their clock,
         after which the next one is set again (reminders/ReminderReceiver). The system sends
         these to a receiver not exported, as to WorkManager's. -->
    <receiver
      android:name=".reminders.ReminderReceiver"
      android:exported="false">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
        <action android:name="android.intent.action.TIME_SET" />
        <action android:name="android.intent.action.TIMEZONE_CHANGED" />
        <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
      </intent-filter>
    </receiver>
    <!-- The camera app writes a photo taken for a face or a mark here (PhotoEditor). -->
    <provider
      android:name="androidx.core.content.FileProvider"
      android:authorities="${applicationId}.photos"
      android:exported="false"
      android:grantUriPermissions="true">
      <meta-data
        android:name="android.support.FILE_PROVIDER_PATHS"
        android:resource="@xml/photo_paths" />
    </provider>
    <!-- 次の休み's and これから's editing: who the widget is set to. Made by the Metro graph, as
         MainActivity is. -->
    <activity
      android:name=".widgets.WidgetWithActivity"
      android:exported="true"
      android:excludeFromRecents="true"
      android:taskAffinity=""
      tools:ignore="Instantiatable">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
      </intent-filter>
    </activity>
    <!-- The home screen widgets (widgets/, spec/widgets.md), drawn by Glance. -->
    <receiver
      android:name=".widgets.SimpleWidgetReceiver"
      android:exported="true"
      android:label="@string/widget_simple">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/widget_simple" />
    </receiver>
    <receiver
      android:name=".widgets.NextOffWidgetReceiver"
      android:exported="true"
      android:label="@string/widget_next_off">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/widget_next_off" />
    </receiver>
    <receiver
      android:name=".widgets.UpcomingWidgetReceiver"
      android:exported="true"
      android:label="@string/widget_upcoming">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/widget_upcoming" />
    </receiver>
    <receiver
      android:name=".widgets.CalendarWidgetReceiver"
      android:exported="true"
      android:label="@string/widget_calendar">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/widget_calendar" />
    </receiver>
    <receiver
      android:name=".widgets.NowWidgetReceiver"
      android:exported="true"
      android:label="@string/widget_now">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/widget_now" />
    </receiver>
    <!-- Midnight's alarm and いまのシフト's turns, the clock set or the time zone changed: the
         widgets are drawn for the moment it is (WidgetUpdates). -->
    <receiver
      android:name=".widgets.WidgetDayReceiver"
      android:exported="false">
      <intent-filter>
        <action android:name="android.intent.action.TIME_SET" />
        <action android:name="android.intent.action.TIMEZONE_CHANGED" />
      </intent-filter>
    </receiver>
  </application>

</manifest>
