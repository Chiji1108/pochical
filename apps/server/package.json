{
  "name": "@pochical/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "auth:schema": "bunx @better-auth/cli@1 generate --config better-auth.config.ts --output src/db/auth-schema.ts -y",
    "db:generate": "drizzle-kit generate",
    "group-do:generate": "drizzle-kit generate --config drizzle.group-do.config.ts",
    "user-do:generate": "drizzle-kit generate --config drizzle.user-do.config.ts",
    "typecheck": "wrangler types && tsc --noEmit",
    "test": "vitest run",
    "check": "bun run --cwd ../.. check",
    "fix": "bun run --cwd ../.. fix"
  },
  "dependencies": {
    "@better-auth/core": "1.7.7",
    "@bufbuild/protobuf": "2.15.0",
    "@connectrpc/connect": "2.2.0",
    "@pochical/design": "workspace:*",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.3"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "2.15.0",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "~6.0.3",
    "vitest": "~4.1.11",
    "wrangler": "^4.141.0"
  }
}
