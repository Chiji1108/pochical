{
  "name": "@pochical/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "cf-typegen": "rm -f worker-configuration.d.ts && wrangler types",
    "auth:schema": "bunx @better-auth/cli@1 generate --config better-auth.config.ts --output src/db/auth-schema.ts -y",
    "db:generate": "drizzle-kit generate",
    "group-do:generate": "drizzle-kit generate --config drizzle.group-do.config.ts",
    "user-do:generate": "drizzle-kit generate --config drizzle.user-do.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tools.json",
    "test": "vitest run",
    "check": "bun run --cwd ../.. check",
    "fix": "bun run --cwd ../.. fix"
  },
  "dependencies": {
    "@better-auth/core": "1.7.12",
    "@bufbuild/protobuf": "2.16.0",
    "@connectrpc/connect": "2.2.0",
    "@pochical/design": "workspace:*",
    "better-auth": "^1.7.12",
    "drizzle-orm": "^0.45.4"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "2.16.0",
    "@cloudflare/vitest-plugin": "1.4.6",
    "@types/node": "24.19.2",
    "drizzle-kit": "^0.31.11",
    "typescript": "~7.0.2",
    "vite": "^8.0.0",
    "vitest": "~5.0.5",
    "wrangler": "^4.151.3"
  }
}
