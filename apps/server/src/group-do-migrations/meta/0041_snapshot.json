        "chat_lines_photos": {
          "name": "chat_lines_photos",
          "columns": [
            "thread_id",
            "seq"
          ],
          "isUnique": false,
          "where": "\"chat_lines\".\"content\" ->> '$.kind' = 'photos'"
        }
      },
      "foreignKeys": {},
      "compositePrimaryKeys": {
        "chat_lines_thread_id_seq_pk": {
          "columns": [
            "thread_id",
            "seq"
          ],
          "name": "chat_lines_thread_id_seq_pk"
        }
      },
      "uniqueConstraints": {},
      "checkConstraints": {
        "chat_lines_content": {
          "name": "chat_lines_content",
          "value": "coalesce(CASE content ->> '$.kind'\n        WHEN 'words' THEN content ->> '$.text' <> ''\n          AND json_type(content, '$.edited') IN ('true', 'false')\n        WHEN 'photos' THEN json_array_length(content, '$.photos') > 0\n        WHEN 'days' THEN json_array_length(content, '$.days') > 0\n        WHEN 'poll' THEN json_array_length(content, '$.days') > 0\n        WHEN 'notice' THEN json_type(content, '$.notice') = 'object'\n          AND reply_to IS NULL AND pinned_at IS NULL\n        WHEN 'unsent' THEN reply_to IS NULL AND pinned_at IS NULL\n      END, 0)"
        }
      }
    },
