{
  "name": "@pochical/admin-svelte",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev --port 3300 --strictPort",
    "build": "vite build",
    "preview": "vite preview --port 3301 --strictPort",
    "cf-typegen": "wrangler types --strict-vars=false -c wrangler.jsonc -c ../server/wrangler.jsonc",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@pochical/design": "workspace:*"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "8.0.1",
    "@sveltejs/kit": "3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "typescript": "~6.0.3",
    "vite": "^8.0.12",
    "wrangler": "^4.137.0"
  }
}
