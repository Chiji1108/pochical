{
  "include": [
    "app/**/*",
    "workers/**/*",
    ".react-router/types/**/*",
    "worker-configuration.d.ts"
  ],
  "compilerOptions": {
    "target": "ES2024",
    "jsx": "react-jsx",
    "module": "ESNext",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": [
      "./worker-configuration.d.ts",
      "../server/worker-configuration.d.ts",
      "vite/client"
    ],
    // React Router's typegen writes each route's types beside it, as
    // ./+types/<route>.
    "rootDirs": [".", "./.react-router/types"],
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    // The server's entrypoint is typed from its own source, checked here too:
    // drizzle-kit writes its Durable Objects' migrations as JS.
    "allowJs": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  }
}
