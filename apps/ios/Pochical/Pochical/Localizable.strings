/* Chat notifications, worded here from the keys and arguments the server
   sends (spec/sync-protocol.md, Push). */

/* Title: the group's name, or the writer's in a one-to-one chat. */
"CHAT_TITLE" = "%@";

/* A group chat's line: who wrote it, then what. */
"CHAT_GROUP_TEXT" = "%1$@: %2$@";
"CHAT_GROUP_PHOTO" = "%@が写真を送りました";
"CHAT_GROUP_DAYS" = "%@が日にちを共有しました";
"CHAT_GROUP_POLL" = "%@が日にちの投票を始めました";

/* A one-to-one chat's line. */
"CHAT_TEXT" = "%@";
"CHAT_PHOTO" = "写真を送りました";
"CHAT_DAYS" = "日にちを共有しました";
"CHAT_POLL" = "日にちの投票を始めました";

/* That a group ends soon (spec/sync-protocol.md, A group's end). Its
   argument is the end in ms, never shown: the Notification Service
   Extension says the day it reads from it (PushWords.words), and these
   words, which name no day, stand where iOS shows the notification as it
   came, the extension not run, or where the argument is no moment. */
"GROUP_ENDS" = "このグループはまもなく終了し、チャットや写真も消えます";

/* What stands in for a body whose key this app has no words for
   (spec/vectors/chat.json, pushBody): a chat line of a kind added after
   it is a message of no kind it can name, and anything else asks to
   update. The server sends none of these keys. */
"CHAT_GROUP_MESSAGE" = "%@がメッセージを送りました";
"CHAT_MESSAGE" = "メッセージを送りました";
"UPDATE_TO_SEE" = "この通知を見るには、アプリをアップデートしてください";

/* The title of an answer's notification in the chat with Pochical's
   people: the chat, as 設定's row names it, its words worded as a
   one-to-one chat's (CHAT_TEXT, CHAT_PHOTO). */
"SUPPORT_TITLE" = "作っている人とチャット";
