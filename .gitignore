# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Builds
dist/

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Swift Package Manager
.build/
.swiftpm/

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
.env

# typescript
*.tsbuildinfo

# Web / Workers
.wrangler/
.output/
.tanstack/
.dev.vars*
!.dev.vars.example

# Panda CSS output, made by `panda codegen`. Panda 2's PostCSS plugin also
# writes a copy in each app, which nothing imports: the apps import the
# package's.
packages/styled-system/dist/
apps/*/styled-system/

# Real roster photos and their answer key: coworkers' names, never commit
assets/shift-schedule/
# Roster reading comparison: resized images, raw replies and the report
tools/roster-eval/out/
# layout-diff's measured runs, remade whenever they are needed
tools/layout-diff/out/
tools/api-try/out/

# Xcode
xcuserdata/

# Screenshots taken while checking /design, never committed.
apps/web/.shots/
