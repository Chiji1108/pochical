# hold: real roster photos with coworkers' names, and its raw replies.
# Never commit them.
assets/shift-schedule/
tools/roster-eval/out/
# layout-diff's measured runs, remade whenever they are needed
tools/layout-diff/out/
tools/api-try/out/

# Xcode
xcuserdata/

# Gradle and Android Studio
apps/android/.gradle/
apps/android/**/build/
apps/android/local.properties
apps/android/.idea/

# Screenshots taken while checking /design, never committed.
apps/web/.shots/
