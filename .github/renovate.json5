{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended", "security:minimumReleaseAgeNpm"],
  timezone: "Asia/Tokyo",
  schedule: ["* 0-8 * * 1"],
  prConcurrentLimit: 5,
  prHourlyLimit: 2,
  labels: ["dependencies"],
  lockFileMaintenance: {
    enabled: true,
    schedule: ["* 0-8 * * 1"],
  },
  customManagers: [
    {
      // Renovate's swift manager reads Package.swift only, not the packages
      // an Xcode project adds itself (renovatebot/renovate#9735).
      customType: "regex",
      description: "Swift packages referenced from Pochical.xcodeproj",
      managerFilePatterns: ["/(^|/)project\\.pbxproj$/"],
      matchStrings: [
        'repositoryURL = "https://github\\.com/(?<depName>[^"]+?)(\\.git)?";\\s*requirement = \\{\\s*kind = exactVersion;\\s*version = (?<currentValue>[^;]+);',
      ],
      datasourceTemplate: "github-tags",
      versioningTemplate: "swift",
    },
    {
      customType: "regex",
      description: "buf remote plugins, versioned with the runtime they generate for",
      managerFilePatterns: ["/(^|/)buf\\.gen\\.yaml$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s*\\n\\s*- remote: \\S+:v(?<currentValue>\\S+)",
      ],
      extractVersionTemplate: "^v?(?<version>.+)$",
    },
  ],
  packageRules: [
    // group:allNonMajor, but a 0.x package's minor update stays a PR of its
    // own: below 1.0 a minor release may break, as budoux's does.
    {
      description: "Every patch, and the minor updates of packages at 1.0 or later, in one PR",
      matchPackageNames: ["*"],
      matchUpdateTypes: ["patch"],
      groupName: "all non-major dependencies",
      groupSlug: "all-minor-patch",
    },
    {
      matchPackageNames: ["*"],
      matchUpdateTypes: ["minor"],
      matchCurrentValue: "!/^[~^=v]?0\\./",
      groupName: "all non-major dependencies",
      groupSlug: "all-minor-patch",
    },
    {
      description: "The same wait as npm's, for Actions, Swift, mise's tools and buf's plugins, which the BSR publishes after the tag",
      matchDatasources: ["github-tags", "github-releases"],
      minimumReleaseAge: "3 days",
      internalChecksFilter: "strict",
    },
    {
      description: "astro check does not support TypeScript 7 yet (withastro/astro#17268)",
      matchFileNames: ["apps/web/package.json"],
      matchDepNames: ["typescript"],
      allowedVersions: "<7",
    },
    {
      description: "@types/node's major is the Node major it describes; keep it at .node-version's (24), and raise this bound in the PR that moves .node-version",
      matchDepNames: ["@types/node"],
      allowedVersions: "<25",
    },
    {
      description: "A Node major's PR reminds whoever merges it to move @types/node and its bound above",
      matchDepNames: ["node"],
      matchUpdateTypes: ["major"],
      prBodyNotes: [
        "Before merging, raise `@types/node`'s `allowedVersions` in `.github/renovate.json5` to the new major and update `@types/node` in every package.json to it.",
      ],
    },
    {
      matchDepNames: ["typescript"],
      matchUpdateTypes: ["major"],
      groupName: "TypeScript",
    },
    {
      matchPackageNames: [
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom",
      ],
      matchUpdateTypes: ["major"],
      groupName: "React",
    },
    {
      description: "@cloudflare/vitest-plugin peers the vitest it runs under",
      matchPackageNames: ["vitest", "@vitest/**", "@cloudflare/vitest-plugin"],
      groupName: "vitest",
      separateMajorMinor: false,
    },
    {
      description: "The generated code and the runtimes it runs on move together",
      matchDepNames: [
        "@bufbuild/protobuf",
        "@bufbuild/protoc-gen-es",
        "@connectrpc/**",
        "apple/swift-protobuf",
        "connectrpc/connect-swift",
        "protocolbuffers/protobuf",
        "connectrpc/connect-kotlin",
        "com.google.protobuf:protobuf-javalite",
        "com.google.protobuf:protobuf-kotlin-lite",
        "com.connectrpc:**",
      ],
      groupName: "protobuf and Connect",
      separateMajorMinor: false,
      prBodyNotes: [
        "Run `mise run gen` and commit the regenerated code before merging (AGENTS.md: generated files are never edited by hand).",
      ],
    },
    {
      description: "Metro is a Kotlin compiler plugin, each release built for the Kotlin versions its docs/compatibility.md names",
      matchDepNames: ["org.jetbrains.kotlin.**", "dev.zacsweers.metro**"],
      groupName: "Kotlin and Metro",
      separateMajorMinor: false,
    },
    {
      description: "Renovate rewrites only the bumped packages' pins in Package.resolved, and none for the Xcode project's own packages",
      matchFileNames: ["**/Package.swift", "**/project.pbxproj"],
      prBodyNotes: [
        "Before merging, resolve the Swift packages (`xcodebuild -resolvePackageDependencies -project apps/ios/Pochical/Pochical.xcodeproj`, and `swift package resolve --package-path` for a changed package under `apps/ios/Packages`) and commit any `Package.resolved` change.",
      ],
    },
  ],
}
