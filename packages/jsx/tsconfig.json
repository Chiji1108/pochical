{
  "include": ["src", "tests"],
  "compilerOptions": {
    "target": "ES2024",
    "jsx": "react-jsx",
    "jsxImportSource": "@pochical/jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "@pochical/jsx": ["./src/index.ts"],
      "@pochical/jsx/*": ["./src/*"]
    },
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["bun"],
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  }
}
